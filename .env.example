# LectureScribe Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Remote Cloud PostgreSQL (Neon DB) - Optional (falls back to local SQLite)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Remote Cloud Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=lecturescribe-rag-index
PINECONE_NAMESPACE=lecturescribe_v1

# Remote Cloud Algolia Search
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_INDEX_NAME=lecturescribe_transcripts_v1

# Llama Model Configuration
LLAMA_MODEL=meta-llama/Llama-3.2-3B-Instruct
LLAMA_API_BASE=
HUGGINGFACE_TOKEN=your_huggingface_token
