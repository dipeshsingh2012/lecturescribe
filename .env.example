# LectureScribe Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Cloud PostgreSQL (Neon DB, Supabase, or AWS RDS) - Required
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Remote Cloud Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=lecturescribe-rag-index
PINECONE_NAMESPACE=lecturescribe_v1

# Remote Cloud Algolia Search
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_INDEX_NAME=lecturescribe_transcripts_v1

# Llama Model Configuration
LLAMA_MODEL=meta-llama/Llama-3.2-3B-Instruct
LLAMA_API_BASE=
HUGGINGFACE_TOKEN=your_huggingface_token

# Google Drive Cloud Upload (1-Click Google Sign-In)
# Web Client ID from Google Cloud Console (OAuth 2.0 Client IDs for Web application)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Hosted Redis (Upstash, Redis Cloud, or Google Memorystore) - Optional / Recommended for RAG caching
REDIS_URL=redis://default:password@host:port
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_DAYS=30

# Google Cloud Storage Resources Bucket
GCS_RESOURCES_BUCKET=lecturescribe-resources

# Moodle iCal Calendar Integration (IIIT Dharwad)
MOODLE_USER_ID=699
MOODLE_AUTH_TOKEN=your_moodle_calendar_auth_token_here
# Optional full feed override:
# MOODLE_ICAL_URL=https://learning.iiitdwd.ac.in/calendar/export_execute.php?userid=699&authtoken=your_token&preset_what=all&preset_time=custom

# Twilio Programmable Messaging (WhatsApp Alert Dispatch)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Cloud Scheduler Automation Security Secret
CRON_SECRET=generate_a_random_secure_hex_key_here


