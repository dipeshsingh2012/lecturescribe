{
  "manifest_version": 3,
  "name": "LectureScribe - Vimeo Video Capture & AI Tutor",
  "version": "1.0.0",
  "description": "Capture Vimeo videos from any LMS or webpage and connect them to LectureScribe for transcripts, summaries, and AI tutoring.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LectureScribe - Capture Vimeo Videos",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lecturescribe-vimeo-capture@lecturescribe.local",
      "strict_min_version": "109.0"
    }
  }
}
